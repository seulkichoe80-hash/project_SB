{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf",
            "hwpx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "xml_path": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        }
      },
      "required": [
        "document_id",
        "version_id",
        "sha256",
        "kind",
        "selector"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "step_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement",
        "step_ids"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "enum": [
            "precedes",
            "conditional",
            "requires"
          ],
          "title": "Relation",
          "type": "string"
        },
        "condition_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Condition Ids",
          "type": "array"
        },
        "explanation": {
          "$ref": "#/$defs/GroundedAssertion"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "condition_ids",
        "explanation"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Chunk Id",
          "type": "string"
        },
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "block_id",
        "start",
        "end",
        "quote"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "title": "Organization Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "source_block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Block Ids",
          "type": "array"
        },
        "source_anchor": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "title": "Source Anchor",
          "type": "array"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        },
        "verification_status": {
          "const": "structural_only",
          "default": "structural_only",
          "title": "Verification Status",
          "type": "string"
        },
        "semantic_verification": {
          "const": "NOT_VERIFIED",
          "default": "NOT_VERIFIED",
          "title": "Semantic Verification",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "document_id",
        "version_id",
        "chunk_id",
        "source_block_ids",
        "source_anchor",
        "spans"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FormRequirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "requirement": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "step_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "requirement",
        "step_ids"
      ],
      "title": "FormRequirement",
      "type": "object"
    },
    "GroundedAssertion": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "GroundedAssertion",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "source_anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "role": {
          "enum": [
            "primary",
            "title_context",
            "table_context",
            "first_row_context",
            "image_parent_context"
          ],
          "title": "Role",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "original_text",
            "original_image",
            "original_structure"
          ],
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "source_anchor",
        "role",
        "start",
        "end",
        "quote",
        "source_kind"
      ],
      "title": "Span",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/GroundedAssertion"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroundedAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/GroundedAssertion"
          },
          "maxItems": 50,
          "title": "Obligations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "actions",
        "deadline",
        "obligations"
      ],
      "title": "Step",
      "type": "object"
    },
    "WorkflowCandidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 200,
          "title": "Conditions",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 400,
          "title": "Edges",
          "type": "array"
        },
        "form_requirements": {
          "items": {
            "$ref": "#/$defs/FormRequirement"
          },
          "maxItems": 200,
          "title": "Form Requirements",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "steps",
        "conditions",
        "edges",
        "form_requirements"
      ],
      "title": "WorkflowCandidate",
      "type": "object"
    },
    "WorkflowReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "target_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Target Ids",
          "type": "array"
        },
        "code": {
          "enum": [
            "INVALID_FORMAT",
            "OUTPUT_LIMIT",
            "DUPLICATE_ID",
            "INVALID_REFERENCE",
            "DUPLICATE_EDGE",
            "ORPHAN_NODE",
            "UNUSED_CONDITION",
            "UNCLEAR_ORDER",
            "UNSUPPORTED_CYCLE",
            "EVIDENCED_REPEAT",
            "INVALID_EVIDENCE",
            "UNSUPPORTED_ASSERTION",
            "UNSUPPORTED_DEADLINE",
            "UNSUPPORTED_AMOUNT",
            "UNSUPPORTED_OBLIGATION",
            "POSSIBLE_CONTEXT_MISMATCH",
            "POSSIBLE_CONFLICT",
            "DOCUMENT_INSTRUCTION",
            "PARTIAL_INPUT",
            "EXTRACTION_REVIEW"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "auto_block": {
          "title": "Auto Block",
          "type": "boolean"
        }
      },
      "required": [
        "target_ids",
        "code",
        "severity",
        "evidence_refs",
        "reason",
        "auto_block"
      ],
      "title": "WorkflowReviewIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "workflow-review-v1",
      "default": "workflow-review-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "input_snapshot_id": {
      "title": "Input Snapshot Id",
      "type": "string"
    },
    "institution_id": {
      "title": "Institution Id",
      "type": "string"
    },
    "document_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Version Id",
      "type": "string"
    },
    "parse_attempt_id": {
      "title": "Parse Attempt Id",
      "type": "string"
    },
    "chunk_job_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Chunk Job Id",
      "type": "string"
    },
    "chunk_generation": {
      "title": "Chunk Generation",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "NEEDS_REVIEW",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "format_validation": {
      "enum": [
        "PASS",
        "REJECTED"
      ],
      "title": "Format Validation",
      "type": "string"
    },
    "evidence_validation": {
      "enum": [
        "PASS",
        "REJECTED",
        "NOT_RUN"
      ],
      "title": "Evidence Validation",
      "type": "string"
    },
    "graph_validation": {
      "enum": [
        "PASS",
        "NEEDS_REVIEW",
        "NOT_RUN"
      ],
      "title": "Graph Validation",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/WorkflowCandidate"
      },
      "maxItems": 20,
      "title": "Candidates",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/WorkflowReviewIssue"
      },
      "maxItems": 5000,
      "title": "Issues",
      "type": "array"
    },
    "semantic_verification": {
      "const": "NOT_VERIFIED",
      "default": "NOT_VERIFIED",
      "title": "Semantic Verification",
      "type": "string"
    },
    "semantic_review_required": {
      "const": true,
      "default": true,
      "title": "Semantic Review Required",
      "type": "boolean"
    },
    "administrator_approval": {
      "const": "NOT_REQUESTED",
      "default": "NOT_REQUESTED",
      "title": "Administrator Approval",
      "type": "string"
    },
    "publishable": {
      "const": false,
      "default": false,
      "title": "Publishable",
      "type": "boolean"
    }
  },
  "required": [
    "input_snapshot_id",
    "institution_id",
    "document_id",
    "version_id",
    "parse_attempt_id",
    "chunk_job_id",
    "chunk_generation",
    "status",
    "format_validation",
    "evidence_validation",
    "graph_validation",
    "candidates",
    "issues"
  ],
  "title": "WorkflowReviewReport",
  "type": "object"
}
