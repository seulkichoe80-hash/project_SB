{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf",
            "hwpx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "xml_path": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        }
      },
      "required": [
        "document_id",
        "version_id",
        "sha256",
        "kind",
        "selector"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "step_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement",
        "step_ids"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "enum": [
            "precedes",
            "conditional",
            "requires"
          ],
          "title": "Relation",
          "type": "string"
        },
        "condition_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Condition Ids",
          "type": "array"
        },
        "explanation": {
          "$ref": "#/$defs/GroundedAssertion"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "condition_ids",
        "explanation"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Chunk Id",
          "type": "string"
        },
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "block_id",
        "start",
        "end",
        "quote"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "title": "Organization Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "source_block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Block Ids",
          "type": "array"
        },
        "source_anchor": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "title": "Source Anchor",
          "type": "array"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        },
        "verification_status": {
          "const": "structural_only",
          "default": "structural_only",
          "title": "Verification Status",
          "type": "string"
        },
        "semantic_verification": {
          "const": "NOT_VERIFIED",
          "default": "NOT_VERIFIED",
          "title": "Semantic Verification",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "document_id",
        "version_id",
        "chunk_id",
        "source_block_ids",
        "source_anchor",
        "spans"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FormMetadata": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "title",
        "purpose"
      ],
      "title": "FormMetadata",
      "type": "object"
    },
    "FormRelationIssue": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Target Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "INVALID_STEP_BINDING",
            "UNSUPPORTED_FORM_CLAIM",
            "NO_REGISTERED_MATCH",
            "AMBIGUOUS_FORM",
            "LEXICAL_MATCH_ONLY",
            "CONDITIONAL_MENTION",
            "MENTION_NOT_OBLIGATION",
            "SOURCE_REVIEW_REQUIRED",
            "CANDIDATE_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "auto_block": {
          "title": "Auto Block",
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "code",
        "severity",
        "evidence_refs",
        "reason",
        "auto_block"
      ],
      "title": "FormRelationIssue",
      "type": "object"
    },
    "FormRequirement": {
      "additionalProperties": false,
