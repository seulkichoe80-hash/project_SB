{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf",
            "hwpx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "xml_path": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        }
      },
      "required": [
        "document_id",
        "version_id",
        "sha256",
        "kind",
        "selector"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "source_anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "role": {
          "enum": [
            "primary",
            "title_context",
            "table_context",
            "first_row_context",
            "image_parent_context"
          ],
          "title": "Role",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "original_text",
            "original_image",
            "original_structure"
          ],
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "source_anchor",
        "role",
        "start",
        "end",
        "quote",
        "source_kind"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "organization_id": {
      "title": "Organization Id",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "chunk_id": {
      "title": "Chunk Id",
      "type": "string"
    },
    "source_block_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Block Ids",
      "type": "array"
    },
    "source_anchor": {
      "items": {
        "$ref": "#/$defs/Anchor"
      },
      "title": "Source Anchor",
      "type": "array"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/Span"
      },
      "title": "Spans",
      "type": "array"
    },
    "verification_status": {
      "const": "structural_only",
      "default": "structural_only",
      "title": "Verification Status",
      "type": "string"
    },
    "semantic_verification": {
      "const": "NOT_VERIFIED",
      "default": "NOT_VERIFIED",
      "title": "Semantic Verification",
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "document_id",
    "version_id",
    "chunk_id",
    "source_block_ids",
    "source_anchor",
    "spans"
  ],
  "title": "EvidenceRef",
  "type": "object"
}