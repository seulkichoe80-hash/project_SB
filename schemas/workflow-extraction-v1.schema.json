{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "step_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement",
        "step_ids"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "enum": [
            "precedes",
            "conditional",
            "requires"
          ],
          "title": "Relation",
          "type": "string"
        },
        "condition_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Condition Ids",
          "type": "array"
        },
        "explanation": {
          "$ref": "#/$defs/GroundedAssertion"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "condition_ids",
        "explanation"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Chunk Id",
          "type": "string"
        },
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "block_id",
        "start",
        "end",
        "quote"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "FormRequirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "requirement": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "step_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "requirement",
        "step_ids"
      ],
      "title": "FormRequirement",
      "type": "object"
    },
    "GroundedAssertion": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "GroundedAssertion",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Target Ids",
          "type": "array"
        },
        "code": {
          "enum": [
            "insufficient_evidence",
            "unclear_order",
            "conflict",
            "form_unresolved",
            "partial_input",
            "semantic_review_required",
            "no_workflow_found"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target_ids",
        "code",
        "message"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/GroundedAssertion"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroundedAssertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/GroundedAssertion"
          },
          "maxItems": 50,
          "title": "Obligations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "actions",
        "deadline",
        "obligations"
      ],
      "title": "Step",
      "type": "object"
    },
    "WorkflowCandidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/GroundedAssertion"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 200,
          "title": "Conditions",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 400,
          "title": "Edges",
          "type": "array"
        },
        "form_requirements": {
          "items": {
            "$ref": "#/$defs/FormRequirement"
          },
          "maxItems": 200,
          "title": "Form Requirements",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "steps",
        "conditions",
        "edges",
        "form_requirements"
      ],
      "title": "WorkflowCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "workflow-extraction-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "workflows": {
      "items": {
        "$ref": "#/$defs/WorkflowCandidate"
      },
      "maxItems": 20,
      "title": "Workflows",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "maxItems": 200,
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "workflows",
    "issues"
  ],
  "title": "WorkflowExtraction",
  "type": "object"
}
